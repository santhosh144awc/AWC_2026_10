---
import BaseLayout from './BaseLayout.astro';
import RelatedArticles from '../components/learning/RelatedArticles.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date | string;
  updatedDate?: Date | string;
  category: string;
  tags?: string[];
  author?: string;
  authorTitle?: string;
  readingTime?: string;
  slug: string;
  calculatorCTA?: {
    title: string;
    description: string;
    buttonLabel: string;
    href: string;
  };
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  category,
  tags = [],
  author = 'C. Santhosh Sathriyan, B.E., QPFP Certified',
  authorTitle = 'AMFI-Registered Mutual Fund Distributor (ARN: 266896)',
  readingTime = '5 min read',
  slug,
  calculatorCTA
} = Astro.props;

const siteUrl = 'https://antwealth.in';
const articleUrl = `${siteUrl}/learn/${slug}`;
const formattedDate = new Date(publishDate).toLocaleDateString('en-IN', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

// JSON-LD Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": author,
    "jobTitle": authorTitle
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ant Wealth Creation",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/assets/logo%20awc.png`
    }
  },
  "datePublished": new Date(publishDate).toISOString(),
  "dateModified": updatedDate ? new Date(updatedDate).toISOString() : new Date(publishDate).toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Learn",
      "item": `${siteUrl}/learn`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": articleUrl
    }
  ]
};
---

<BaseLayout 
  title={`${title} — Ant Wealth Creation`} 
  description={description}
  currentPath="/learn"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="article-page-container">
    {/* Breadcrumb Header */}
    <div class="container article-breadcrumb-wrapper">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/learn" class="breadcrumb-link">Learn</a>
        <span class="breadcrumb-sep">/</span>
        <a href={`/learn?cat=${encodeURIComponent(category)}`} class="breadcrumb-link">{category}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{title}</span>
      </nav>
    </div>

    {/* Hero Article Header */}
    <header class="article-header-section">
      <div class="container text-center">
        <div class="category-header-pill">
          <span class="category-header-dot"></span>
          {category}
        </div>
        
        <h1 class="article-main-title">{title}</h1>
        
        <p class="article-lead-description">{description}</p>
        
        <div class="article-meta-bar">
          <div class="author-meta-block">
            <div class="author-avatar-badge">CS</div>
            <div class="author-text-info">
              <span class="author-name">{author}</span>
              <span class="author-credentials">{authorTitle}</span>
            </div>
          </div>
          
          <div class="article-date-meta">
            <span>📅 {formattedDate}</span>
            <span class="meta-dot">•</span>
            <span>⏱️ {readingTime}</span>
          </div>
        </div>
      </div>
    </header>

    {/* Main Article Content & Sidebar Layout */}
    <div class="container article-content-layout">
      <div class="article-main-body">
        {/* Markdown Content */}
        <div class="markdown-prose">
          <slot />
        </div>

        {/* Relevant Calculator CTA Banner (Optional, Un-gated) */}
        {calculatorCTA && (
          <div class="article-calculator-card">
            <div class="calc-card-icon">🧮</div>
            <div class="calc-card-content">
              <span class="calc-card-tag">Interactive Planning Tool</span>
              <h4 class="calc-card-title">{calculatorCTA.title}</h4>
              <p class="calc-card-desc">{calculatorCTA.description}</p>
              <a href={calculatorCTA.href} class="calc-card-btn">
                {calculatorCTA.buttonLabel} →
              </a>
            </div>
          </div>
        )}

        {/* Regulatory Disclosure Card */}
        <div class="regulatory-disclosure-card">
          <h4 class="disclosure-title">Regulatory Disclosures & Investor Awareness</h4>
          <p class="disclosure-text">
            Ant Wealth Creation is an AMFI-Registered Mutual Fund Distributor (ARN: 266896). Mutual Fund investments are subject to market risks, read all scheme related documents carefully. The content provided in this article is strictly for financial literacy and educational purposes and does not constitute personalized financial or investment advice.
          </p>
        </div>

        {/* Related Articles Component */}
        <RelatedArticles currentSlug={slug} category={category} />

        {/* Back Link */}
        <div class="back-to-hub-wrapper">
          <a href="/learn" class="btn-back-hub">
            ← Back to All Money Made Simple Guides
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page-container {
    background-color: #FFFFFF;
    padding-bottom: 5rem;
  }

  .article-breadcrumb-wrapper {
    padding-top: 1.5rem;
    padding-bottom: 1rem;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: #64748B;
  }

  .breadcrumb-link {
    color: #64748B;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #00AB96;
  }

  .breadcrumb-sep {
    color: #CBD5E1;
  }

  .breadcrumb-current {
    color: #00182A;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 250px;
  }

  /* Header */
  .article-header-section {
    background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
    padding: 3rem 1.5rem 3.5rem;
    border-bottom: 1px solid #F1F5F9;
  }

  .category-header-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: rgba(0, 171, 150, 0.1);
    color: #00AB96;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .category-header-dot {
    width: 6px;
    height: 6px;
    background-color: #00AB96;
    border-radius: 50%;
  }

  .article-main-title {
    font-family: 'Outfit', sans-serif;
    font-size: 2.75rem;
    font-weight: 800;
    color: #00182A;
    line-height: 1.2;
    max-width: 860px;
    margin: 0 auto 1.25rem;
  }

  .article-lead-description {
    font-size: 1.15rem;
    color: #475569;
    max-width: 760px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .article-meta-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #E2E8F0;
    max-width: 760px;
    margin: 0 auto;
  }

  .author-meta-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
  }

  .author-avatar-badge {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #00182A;
    color: #FFFFFF;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-text-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #00182A;
  }

  .author-credentials {
    font-size: 0.75rem;
    color: #64748B;
  }

  .article-date-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #64748B;
    font-weight: 500;
  }

  .meta-dot {
    color: #CBD5E1;
  }

  /* Content Layout */
  .article-content-layout {
    max-width: 820px;
    margin: 0 auto;
    padding-top: 3rem;
  }

  /* Markdown Prose */
  .markdown-prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #334155;
  }

  .markdown-prose :global(h2) {
    font-family: 'Outfit', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #00182A;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .markdown-prose :global(h3) {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #00182A;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .markdown-prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .markdown-prose :global(ul),
  .markdown-prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .markdown-prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .markdown-prose :global(strong) {
    color: #00182A;
    font-weight: 700;
  }

  .markdown-prose :global(a) {
    color: #00AB96;
    text-decoration: underline;
    font-weight: 600;
  }

  .markdown-prose :global(a:hover) {
    color: #008f7d;
  }

  .markdown-prose :global(hr) {
    border: none;
    border-top: 1px solid #E2E8F0;
    margin: 2.5rem 0;
  }

  .markdown-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
  }

  .markdown-prose :global(th) {
    background-color: #F8FAFC;
    color: #00182A;
    font-weight: 700;
    padding: 0.85rem 1rem;
    text-align: left;
    border-bottom: 2px solid #CBD5E1;
  }

  .markdown-prose :global(td) {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #E2E8F0;
  }

  .markdown-prose :global(blockquote) {
    background-color: #F8FAFC;
    border-left: 4px solid #00AB96;
    padding: 1.25rem 1.5rem;
    border-radius: 0 10px 10px 0;
    margin: 2rem 0;
    color: #1E293B;
  }

  /* Calculator CTA Box */
  .article-calculator-card {
    background: linear-gradient(135deg, #00182A 0%, #002B49 100%);
    border-radius: 14px;
    padding: 2rem;
    color: #FFFFFF;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin: 3rem 0;
  }

  .calc-card-icon {
    font-size: 2.5rem;
    background-color: rgba(255, 255, 255, 0.1);
    width: 64px;
    height: 64px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .calc-card-content {
    display: flex;
    flex-direction: column;
  }

  .calc-card-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #00AB96;
    margin-bottom: 0.35rem;
  }

  .calc-card-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.35rem;
  }

  .calc-card-desc {
    font-size: 0.9rem;
    color: #CBD5E1;
    margin-bottom: 1rem;
    line-height: 1.45;
  }

  .calc-card-btn {
    display: inline-block;
    align-self: flex-start;
    background-color: #00AB96;
    color: #FFFFFF;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .calc-card-btn:hover {
    background-color: #008f7d;
    transform: translateY(-2px);
  }

  /* Regulatory Card */
  .regulatory-disclosure-card {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 3rem 0;
  }

  .disclosure-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #00182A;
    margin-bottom: 0.5rem;
  }

  .disclosure-text {
    font-size: 0.8rem;
    color: #64748B;
    line-height: 1.5;
    margin-bottom: 0;
  }

  .back-to-hub-wrapper {
    margin-top: 2.5rem;
    text-align: center;
  }

  .btn-back-hub {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #00182A;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid #CBD5E1;
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .btn-back-hub:hover {
    background-color: #F1F5F9;
    border-color: #00182A;
  }

  @media (max-width: 768px) {
    .article-main-title {
      font-size: 2rem;
    }
    .article-lead-description {
      font-size: 1rem;
    }
    .article-calculator-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }
  }
</style>
