---
import { siteConfig } from '../data/siteConfig';
---

<section class="trust-section">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-heading-col">
        <h2 class="trust-main-title">
          Why families choose <br class="hide-mobile" />
          <span class="text-teal">Ant Wealth Creation</span>
        </h2>
        <p class="trust-main-desc">
          Built on principles of discipline, transparency, and lifelong client relationships.
        </p>
      </div>

      <div class="pillars-row">
        {siteConfig.trustPillars.map((pillar) => (
          <div class="pillar-item">
            <div class="pillar-icon-box">
              {pillar.icon === 'calendar' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                  <line x1="16" x2="16" y1="2" y2="6"></line>
                  <line x1="8" x2="8" y1="2" y2="6"></line>
                  <line x1="3" x2="21" y1="10" y2="10"></line>
                </svg>
              )}
              {pillar.icon === 'shield-check' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              )}
              {pillar.icon === 'user-heart' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              )}
              {pillar.icon === 'sparkles' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                </svg>
              )}
              {pillar.icon === 'trending-up' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                  <polyline points="16 7 22 7 22 13"></polyline>
                </svg>
              )}
            </div>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-subtitle">{pillar.subtitle}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    background-color: var(--color-primary-navy);
    color: var(--color-white);
    padding: 4.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .trust-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .trust-heading-col {
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }

  .trust-main-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .text-teal {
    color: var(--color-growth-teal);
  }

  .trust-main-desc {
    font-size: 1.05rem;
    color: var(--color-slate-light);
  }

  .pillars-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .pillar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform var(--transition-normal), background-color var(--transition-normal);
  }

  .pillar-item:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-3px);
    border-color: var(--color-growth-teal);
  }

  .pillar-icon-box {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: rgba(0, 171, 150, 0.15);
    color: var(--color-growth-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .pillar-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 0.35rem;
  }

  .pillar-subtitle {
    font-size: 0.85rem;
    color: var(--color-slate-light);
    line-height: 1.35;
  }

  @media (max-width: 992px) {
    .pillars-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .pillars-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 440px) {
    .pillars-row {
      grid-template-columns: 1fr;
    }
  }
</style>
