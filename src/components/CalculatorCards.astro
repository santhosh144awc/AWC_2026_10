---
// 4 Clear Starting Cards for Visitor Discovery
const startingPoints = [
  {
    id: "health",
    title: "Understand My Finances",
    description: "See where you stand today and what you may want to improve.",
    cta: "Check My Financial Health →",
    href: "/health-check",
    icon: "🩺"
  },
  {
    id: "goal",
    title: "Plan a Goal",
    description: "Plan for a home, education, retirement or another important goal.",
    cta: "Plan a Goal →",
    href: "/plan",
    icon: "🎯"
  },
  {
    id: "investment",
    title: "Grow My Money",
    description: "Explore how SIP and lumpsum investments may grow over time.",
    cta: "Explore Investments →",
    href: "/tools?calc=sip",
    icon: "📈"
  },
  {
    id: "protection",
    title: "Protect My Family",
    description: "Get an illustrative view of your family's financial protection need.",
    cta: "Check Protection Need →",
    href: "/tools?calc=insurance",
    icon: "🛡️"
  }
];
---

<section class="pathway-discovery-section section-padding">
  <div class="container">
    <!-- Header -->
    <div class="section-header text-center">
      <h2 class="section-title">Where would you like to start?</h2>
      <p class="section-subtitle">
        Choose what matters to you right now.
      </p>
    </div>

    <!-- 4 Primary Pathways Grid -->
    <div class="pathway-grid">
      {startingPoints.map((item) => (
        <div class="pathway-card card-base">
          <div class="card-top">
            <span class="pathway-icon" aria-hidden="true">{item.icon}</span>
          </div>
          <h3 class="pathway-title">{item.title}</h3>
          <p class="pathway-desc">{item.description}</p>
          <a href={item.href} class="btn-pathway">
            {item.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pathway-discovery-section {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    padding: 5rem 1.5rem;
  }

  .badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background-color: rgba(0, 171, 150, 0.1);
    color: var(--color-growth-teal);
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-growth-teal);
    border-radius: 50%;
  }

  .section-header {
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-family: 'Outfit', sans-serif;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary-navy);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.5;
  }

  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 1024px) {
    .pathway-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .pathway-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .pathway-card {
    background-color: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0, 24, 42, 0.03);
    transition: all 0.25s ease;
  }

  .pathway-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-growth-teal);
    box-shadow: 0 12px 28px rgba(0, 171, 150, 0.1);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .pathway-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .pathway-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #0F766E;
    background-color: #CCFBF1;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
  }

  .pathway-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .pathway-desc {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.5;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .btn-pathway {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    background-color: var(--color-growth-teal);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    min-height: 44px;
  }

  .btn-pathway:hover {
    background-color: #008F7E;
    box-shadow: 0 4px 12px rgba(0, 171, 150, 0.25);
  }

  /* Guidance Banner */
  .guidance-banner {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    padding: 2.25rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 15px rgba(0, 24, 42, 0.02);
  }

  .guidance-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .guidance-tag {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0F766E;
    margin-bottom: 0.5rem;
  }

  .guidance-heading {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    margin: 0;
  }

  .guidance-steps {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .guidance-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
  }

  .step-num {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 50%;
    background-color: var(--color-growth-teal);
    color: #FFFFFF;
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-text {
    display: flex;
    flex-direction: column;
  }

  .step-text strong {
    font-size: 0.9rem;
    color: var(--color-primary-navy);
  }

  .step-text span {
    font-size: 0.78rem;
    color: #64748B;
    line-height: 1.3;
  }

  .guidance-arrow {
    font-size: 1.25rem;
    color: #94A3B8;
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .guidance-steps {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .guidance-arrow {
      display: none;
    }
  }

  .section-footer-link {
    text-align: center;
  }

  .footer-subtle-text {
    font-size: 1rem;
    color: #475569;
    margin: 0;
  }

  .link-view-all {
    font-weight: 700;
    color: var(--color-growth-teal);
    text-decoration: none;
    margin-left: 0.35rem;
    transition: all 0.2s ease;
  }

  .link-view-all:hover {
    color: #008F7E;
    text-decoration: underline;
  }
</style>
