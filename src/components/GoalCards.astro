---
import { siteConfig } from '../data/siteConfig';
---

<section class="goals-section section-padding">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">What are you planning for?</h2>
      <p class="section-subtitle">
        Select your life milestone to discover clear, step-by-step guidance and calculators tailored to your goals.
      </p>
    </div>

    <div class="goals-grid">
      {siteConfig.goals.map((goal) => (
        <a href={goal.href} class="goal-card card-base">
          <div class="goal-icon-wrapper" style={`--goal-color: ${goal.color}; background-color: ${goal.color}15;`}>
            {goal.id === 'home' && (
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            )}
            {goal.id === 'education' && (
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            )}
            {goal.id === 'retirement' && (
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="M20 12h2"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
                <path d="M15.95 16.5A6 6 0 0 0 18 12h-4"></path>
                <path d="M2 12h2"></path>
                <path d="M4 18h16"></path>
                <path d="M8 22h8"></path>
              </svg>
            )}
            {goal.id === 'wealth' && (
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20"></path>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            )}
            {goal.id === 'protection' && (
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            )}
            {goal.id === 'income' && (
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                <line x1="2" x2="22" y1="10" y2="10"></line>
              </svg>
            )}
          </div>
          <h3 class="goal-title">{goal.title}</h3>
        </a>
      ))}
    </div>

    <div class="section-footer-link">
      <a href="/plan" class="link-with-arrow">
        Plan Your Goals
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .goals-section {
    background-color: var(--color-white);
  }

  .goals-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 1200px) {
    .goals-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .goals-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  .goal-card {
    padding: 2.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius-xl);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-normal);
  }

  .goal-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-growth-teal);
    box-shadow: var(--shadow-card-hover);
  }

  .goal-icon-wrapper {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-lg);
    color: var(--goal-color, var(--color-growth-teal));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: transform var(--transition-normal);
  }

  .goal-card:hover .goal-icon-wrapper {
    transform: scale(1.1);
  }

  .goal-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    line-height: 1.3;
  }

  .section-footer-link {
    text-align: center;
  }

  .link-with-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary-navy);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .link-with-arrow:hover {
    color: var(--color-growth-teal);
    transform: translateX(3px);
  }
</style>
