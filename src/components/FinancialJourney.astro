---
import { FINANCIAL_JOURNEY_STAGES } from '../data/financialJourney';
---

<section class="journey-section section-padding" id="financial-journey">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">Your Financial Wellbeing Journey</h2>
      <p class="section-subtitle">
        Every family moves through different financial stages. Select a stage to understand what matters most at that point in your journey.
      </p>
    </div>

    <!-- Two-Column Interactive Journey Experience -->
    <div class="journey-experience-layout">
      <!-- Left Column: Stage Navigation Selector -->
      <div class="journey-nav-col" role="tablist" aria-label="Financial Wellbeing Journey Stages" aria-orientation="vertical">
        {FINANCIAL_JOURNEY_STAGES.map((stage) => {
          const isFirst = stage.id === 1;
          return (
            <button
              type="button"
              role="tab"
              id={`journey-tab-${stage.id}`}
              class={`stage-nav-item ${isFirst ? 'active' : ''}`}
              aria-selected={isFirst ? 'true' : 'false'}
              aria-controls={`journey-panel-${stage.id}`}
              tabindex={isFirst ? 0 : -1}
              data-stage-id={stage.id}
            >
              <span class="stage-nav-number">{stage.step}</span>
              <div class="stage-nav-text">
                <span class="stage-nav-title">{stage.title}</span>
                <span class="stage-nav-desc">{stage.shortDescription}</span>
              </div>
              <span class="stage-nav-arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </span>
            </button>
          );
        })}
      </div>

      <!-- Right Column: Educational Information Panel -->
      <div class="journey-info-col">
        {FINANCIAL_JOURNEY_STAGES.map((stage) => {
          const isFirst = stage.id === 1;
          return (
            <div
              id={`journey-panel-${stage.id}`}
              role="tabpanel"
              aria-labelledby={`journey-tab-${stage.id}`}
              class={`journey-info-card ${isFirst ? 'active' : ''}`}
              hidden={!isFirst}
            >
              <!-- Panel Header -->
              <div class="info-card-header">
                <span class="info-stage-badge">Stage {stage.step} of 6</span>
                <h3 class="info-stage-title">{stage.title}</h3>
                <p class="info-stage-sub">{stage.shortDescription}</p>
              </div>

              <!-- Educational Introduction -->
              <p class="info-intro-text">{stage.introduction}</p>

              <!-- Focus Areas Checklist -->
              <div class="info-focus-section">
                <h4 class="info-focus-heading">What to focus on</h4>
                <ul class="info-focus-list" role="list">
                  {stage.focusAreas.map((area) => (
                    <li class="info-focus-item">
                      <span class="info-check-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </span>
                      <span class="info-focus-label">{area}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Simple Takeaway / Tip -->
              <div class="info-takeaway-box">
                <span class="takeaway-icon" aria-hidden="true">💡</span>
                <p class="takeaway-text">
                  <strong>Simple takeaway:</strong> {stage.tip}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  function initFinancialJourneyStepper() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.journey-nav-col .stage-nav-item');
    const panels = document.querySelectorAll<HTMLElement>('.journey-info-card');

    if (!tabButtons.length || !panels.length) return;

    function activateStage(stageId: number) {
      tabButtons.forEach((btn) => {
        const id = Number(btn.getAttribute('data-stage-id'));
        const isActive = id === stageId;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        btn.tabIndex = isActive ? 0 : -1;
      });

      panels.forEach((panel) => {
        const id = Number(panel.id.replace('journey-panel-', ''));
        const isActive = id === stageId;
        if (isActive) {
          panel.hidden = false;
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
          panel.hidden = true;
        }
      });
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const stageId = Number(btn.getAttribute('data-stage-id'));
        activateStage(stageId);
      });

      btn.addEventListener('keydown', (e) => {
        const currentIndex = Array.from(tabButtons).indexOf(btn);
        let targetIndex = -1;

        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          targetIndex = (currentIndex + 1) % tabButtons.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          targetIndex = (currentIndex - 1 + tabButtons.length) % tabButtons.length;
        } else if (e.key === 'Home') {
          targetIndex = 0;
        } else if (e.key === 'End') {
          targetIndex = tabButtons.length - 1;
        }

        if (targetIndex !== -1) {
          e.preventDefault();
          const targetBtn = tabButtons[targetIndex];
          targetBtn.focus();
          const stageId = Number(targetBtn.getAttribute('data-stage-id'));
          activateStage(stageId);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFinancialJourneyStepper);
  } else {
    initFinancialJourneyStepper();
  }
  document.addEventListener('astro:page-load', initFinancialJourneyStepper);
</script>

<style>
  .journey-section {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    padding: 4.5rem 0;
    overflow: hidden;
  }

  .section-header {
    max-width: 720px;
    margin: 0 auto 2.75rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--color-slate-text, #334155);
    line-height: 1.5;
  }

  /* Two-Column Desktop Layout */
  .journey-experience-layout {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 2rem;
    align-items: stretch;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  /* Left Navigation Column */
  .journey-nav-col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .stage-nav-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    text-align: left;
    padding: 0.9rem 1.15rem;
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 12px;
    transition: all 0.2s ease;
    cursor: pointer;
    position: relative;
    outline: none;
  }

  .stage-nav-item:focus-visible {
    outline: 2px solid var(--color-growth-teal, #00AB96);
    outline-offset: 2px;
  }

  .stage-nav-item:hover {
    border-color: #CBD5E1;
    background: #FFFFFF;
    transform: translateX(3px);
    box-shadow: 0 4px 12px rgba(0, 24, 42, 0.04);
  }

  .stage-nav-number {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    font-weight: 800;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    flex-shrink: 0;
    background: #F1F5F9;
    color: var(--color-primary-navy, #00182A);
    border: 2px solid #E2E8F0;
    transition: all 0.2s ease;
  }

  .stage-nav-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-grow: 1;
    min-width: 0;
  }

  .stage-nav-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-navy, #00182A);
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .stage-nav-desc {
    font-size: 0.775rem;
    color: var(--color-slate-muted, #64748B);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stage-nav-arrow {
    color: #94A3B8;
    transition: all 0.2s ease;
    flex-shrink: 0;
    opacity: 0.4;
    display: flex;
    align-items: center;
  }

  /* Active Stage Nav Item */
  .stage-nav-item.active {
    border-color: var(--color-growth-teal, #00AB96);
    background: rgba(0, 171, 150, 0.04);
    box-shadow: 0 4px 16px rgba(0, 171, 150, 0.1);
  }

  .stage-nav-item.active .stage-nav-number {
    background: var(--color-primary-navy, #00182A);
    color: #FFFFFF;
    border-color: var(--color-growth-teal, #00AB96);
    box-shadow: 0 0 0 3px rgba(0, 171, 150, 0.2);
  }

  .stage-nav-item.active .stage-nav-title {
    color: var(--color-growth-teal, #00AB96);
  }

  .stage-nav-item.active .stage-nav-arrow {
    color: var(--color-growth-teal, #00AB96);
    transform: translateX(2px);
    opacity: 1;
  }

  /* Right Information Column */
  .journey-info-col {
    position: relative;
    display: flex;
    width: 100%;
    min-width: 0;
  }

  .journey-info-card {
    display: none;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 2rem 2.25rem;
    box-shadow: 0 10px 25px -5px rgba(0, 24, 42, 0.05), 0 4px 10px -2px rgba(0, 24, 42, 0.02);
    width: 100%;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .journey-info-card.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .journey-info-card[hidden] {
    display: none !important;
  }

  .info-card-header {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #F1F5F9;
  }

  .info-stage-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-growth-teal, #00AB96);
    background: rgba(0, 171, 150, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .info-stage-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .info-stage-sub {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-slate-muted, #64748B);
  }

  .info-intro-text {
    font-size: 0.975rem;
    color: var(--color-slate-text, #334155);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* What to Focus On */
  .info-focus-section {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 1.15rem 1.35rem;
    margin-bottom: 1.25rem;
  }

  .info-focus-heading {
    font-size: 0.825rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .info-focus-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem 1rem;
  }

  .info-focus-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .info-check-icon {
    color: var(--color-growth-teal, #00AB96);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .info-focus-label {
    font-size: 0.875rem;
    color: var(--color-primary-navy, #00182A);
    font-weight: 600;
    line-height: 1.4;
  }

  /* Simple Takeaway Box */
  .info-takeaway-box {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background: rgba(0, 171, 150, 0.06);
    border-left: 3px solid var(--color-growth-teal, #00AB96);
    border-radius: 0 8px 8px 0;
    padding: 0.85rem 1.15rem;
    margin-top: auto;
  }

  .takeaway-icon {
    font-size: 1.1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .takeaway-text {
    font-size: 0.875rem;
    color: var(--color-slate-text, #334155);
    line-height: 1.5;
    margin: 0;
  }

  .takeaway-text strong {
    color: var(--color-primary-navy, #00182A);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .stage-nav-item,
    .stage-nav-number,
    .journey-info-card {
      transition: none !important;
      transform: none !important;
    }
  }

  /* Tablet & Mobile Responsive */
  @media (max-width: 1023px) {
    .journey-experience-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .journey-nav-col {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-left: -1rem;
      margin-right: -1rem;
      padding: 0.25rem 1rem 0.75rem 1rem;
      gap: 0.75rem;
    }

    .journey-nav-col::-webkit-scrollbar {
      display: none;
    }

    .stage-nav-item {
      flex: 0 0 190px;
      max-width: 190px;
      scroll-snap-align: start;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding: 1rem 0.85rem;
    }

    .stage-nav-arrow {
      display: none;
    }

    .stage-nav-desc {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .info-focus-list {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
  }

  @media (max-width: 640px) {
    .journey-section {
      padding: 3.5rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-title {
      font-size: 1.85rem;
    }

    .journey-info-card {
      padding: 1.5rem 1.25rem;
      border-radius: 14px;
    }

    .info-stage-title {
      font-size: 1.35rem;
    }

    .info-focus-section {
      padding: 1rem 1.15rem;
    }
  }
</style>
