---
import { FINANCIAL_JOURNEY_STAGES } from '../data/financialJourney';
---

<section class="journey-section section-padding" id="financial-journey">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">Your Financial Wellbeing Journey</h2>
      <p class="section-subtitle">
        Every family moves through different financial stages. Select a stage to understand what matters most at that point in your journey.
      </p>
    </div>

    <!-- 1. Horizontal 1–6 Journey Track -->
    <div class="journey-track-wrapper">
      <div class="journey-stepper-track" role="tablist" aria-label="Financial Wellbeing Journey Stages">
        <div class="journey-connecting-line" aria-hidden="true"></div>
        {FINANCIAL_JOURNEY_STAGES.map((stage, idx) => {
          return (
            <button
              type="button"
              role="tab"
              id={`journey-tab-${stage.id}`}
              class="journey-step-btn"
              aria-selected="false"
              aria-expanded="false"
              aria-controls={`journey-panel-${stage.id}`}
              tabindex={idx === 0 ? 0 : -1}
              data-stage-id={stage.id}
            >
              <span class="step-circle">
                <span class="step-number">{stage.step}</span>
              </span>
              <div class="step-label-group">
                <span class="step-title">{stage.title}</span>
                <span class="step-subtitle">{stage.shortDescription}</span>
              </div>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Non-Linear Journey Educational Note -->
    <p class="journey-note text-center">
      Your financial journey isn't always linear. Your priorities can change as life changes.
    </p>

    <!-- 2. Smooth Disclosure Wrapper & Educational Information Panel Below Stepper -->
    <div class="journey-disclosure-wrapper" id="journey-disclosure-wrapper" aria-hidden="true">
      <div class="journey-disclosure-inner">
        <div class="journey-panel-container">
          {FINANCIAL_JOURNEY_STAGES.map((stage) => {
            return (
              <div
                id={`journey-panel-${stage.id}`}
                role="tabpanel"
                aria-labelledby={`journey-tab-${stage.id}`}
                class="journey-info-card"
                hidden
              >
                <!-- Left Side of Card: Stage Title & Educational Overview -->
                <div class="card-left-col">
                  <span class="panel-stage-badge">Stage {stage.step} of 6</span>
                  <h3 class="panel-stage-title">{stage.title}</h3>
                  <p class="panel-stage-sub">{stage.shortDescription}</p>
                  <p class="panel-intro-text">{stage.introduction}</p>
                </div>

                <!-- Right Side of Card: What to Focus On & Simple Takeaway -->
                <div class="card-right-col">
                  <div class="panel-focus-box">
                    <h4 class="focus-heading">What to focus on</h4>
                    <ul class="focus-checklist" role="list">
                      {stage.focusAreas.map((area) => (
                        <li class="focus-item">
                          <span class="check-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                          </span>
                          <span class="focus-text">{area}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="panel-takeaway-box">
                    <span class="takeaway-badge">💡 Simple takeaway</span>
                    <p class="takeaway-text">{stage.tip}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initFinancialJourneyStepper() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.journey-stepper-track .journey-step-btn');
    const panels = document.querySelectorAll<HTMLElement>('.journey-info-card');
    const disclosureWrapper = document.getElementById('journey-disclosure-wrapper');

    if (!tabButtons.length || !panels.length || !disclosureWrapper) return;

    let activeStageId: number | null = null;
    let closeTimeout: number | undefined;

    function openStage(stageId: number) {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = undefined;
      }

      activeStageId = stageId;

      // Update button states
      tabButtons.forEach((btn) => {
        const id = Number(btn.getAttribute('data-stage-id'));
        const isActive = id === stageId;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
        btn.tabIndex = isActive ? 0 : -1;
      });

      // Update panel states
      panels.forEach((panel) => {
        const id = Number(panel.id.replace('journey-panel-', ''));
        const isActive = id === stageId;
        if (isActive) {
          panel.hidden = false;
          // Trigger reflow for smooth opacity/transform transition
          void panel.offsetWidth;
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
          panel.hidden = true;
        }
      });

      // Open disclosure wrapper
      disclosureWrapper.classList.add('is-open');
      disclosureWrapper.setAttribute('aria-hidden', 'false');
    }

    function closeStage() {
      activeStageId = null;

      // Reset button states
      tabButtons.forEach((btn, idx) => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
        btn.setAttribute('aria-expanded', 'false');
        btn.tabIndex = idx === 0 ? 0 : -1;
      });

      // Start panel fade out
      panels.forEach((panel) => {
        panel.classList.remove('active');
      });

      // Close disclosure wrapper
      disclosureWrapper.classList.remove('is-open');
      disclosureWrapper.setAttribute('aria-hidden', 'true');

      // Set hidden after transition completes
      closeTimeout = window.setTimeout(() => {
        if (activeStageId === null) {
          panels.forEach((panel) => {
            panel.hidden = true;
          });
        }
      }, 300);
    }

    function toggleStage(stageId: number) {
      if (activeStageId === stageId) {
        closeStage();
      } else {
        openStage(stageId);
      }
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const stageId = Number(btn.getAttribute('data-stage-id'));
        toggleStage(stageId);
      });

      btn.addEventListener('keydown', (e) => {
        const currentIndex = Array.from(tabButtons).indexOf(btn);
        let targetIndex = -1;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          targetIndex = (currentIndex + 1) % tabButtons.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          targetIndex = (currentIndex - 1 + tabButtons.length) % tabButtons.length;
        } else if (e.key === 'Home') {
          targetIndex = 0;
        } else if (e.key === 'End') {
          targetIndex = tabButtons.length - 1;
        }

        if (targetIndex !== -1) {
          e.preventDefault();
          const targetBtn = tabButtons[targetIndex];
          targetBtn.focus();
          const stageId = Number(targetBtn.getAttribute('data-stage-id'));
          openStage(stageId);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFinancialJourneyStepper);
  } else {
    initFinancialJourneyStepper();
  }
  document.addEventListener('astro:page-load', initFinancialJourneyStepper);
</script>

<style>
  .journey-section {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    padding: 4.5rem 0;
    overflow: hidden;
  }

  .section-header {
    max-width: 720px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--color-slate-text, #334155);
    line-height: 1.5;
  }

  /* 1. Horizontal Stepper Track */
  .journey-track-wrapper {
    max-width: 1100px;
    margin: 0 auto 1.5rem;
    position: relative;
  }

  .journey-stepper-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  /* Connecting Track Line behind numbered circles */
  .journey-connecting-line {
    position: absolute;
    top: 24px;
    left: 8%;
    right: 8%;
    height: 3px;
    background: linear-gradient(90deg, #CBD5E1 0%, #E2E8F0 100%);
    z-index: 1;
  }

  .journey-step-btn {
    position: relative;
    z-index: 2;
    background: transparent;
    border: none;
    padding: 0 0.25rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    outline: none;
    transition: transform 0.2s ease;
  }

  .journey-step-btn:focus-visible .step-circle {
    outline: 2px solid var(--color-growth-teal, #00AB96);
    outline-offset: 3px;
  }

  .step-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2.5px solid #CBD5E1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    box-shadow: 0 4px 10px rgba(0, 24, 42, 0.04);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .step-number {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    transition: color 0.2s ease;
  }

  .step-label-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: 100%;
  }

  .step-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-navy, #00182A);
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .step-subtitle {
    font-size: 0.775rem;
    color: var(--color-slate-muted, #64748B);
    line-height: 1.35;
  }

  .journey-step-btn:hover:not(.active) .step-circle {
    border-color: var(--color-growth-teal, #00AB96);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0, 171, 150, 0.15);
  }

  .journey-step-btn:hover:not(.active) .step-title {
    color: var(--color-growth-teal, #00AB96);
  }

  /* Active Stage Visuals */
  .journey-step-btn.active .step-circle {
    background: var(--color-primary-navy, #00182A);
    border-color: var(--color-growth-teal, #00AB96);
    box-shadow: 0 0 0 4px rgba(0, 171, 150, 0.25), 0 8px 16px rgba(0, 24, 42, 0.12);
    transform: scale(1.08);
  }

  .journey-step-btn.active .step-number {
    color: #FFFFFF;
  }

  .journey-step-btn.active .step-title {
    color: var(--color-growth-teal, #00AB96);
    font-weight: 800;
  }

  /* Non-Linear Journey Note */
  .journey-note {
    font-size: 0.925rem;
    color: var(--color-slate-muted, #64748B);
    line-height: 1.5;
    margin: 0 auto;
    max-width: 680px;
    font-style: italic;
  }

  /* 2. Smooth Disclosure Wrapper & Educational Information Panel Below Stepper */
  .journey-disclosure-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms cubic-bezier(0.16, 1, 0.3, 1), margin-top 300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 250ms ease;
    margin-top: 0;
    opacity: 0;
  }

  .journey-disclosure-wrapper.is-open {
    grid-template-rows: 1fr;
    margin-top: 2rem;
    opacity: 1;
  }

  .journey-disclosure-inner {
    overflow: hidden;
    min-height: 0;
  }

  .journey-panel-container {
    max-width: 980px;
    margin: 0 auto;
    padding: 6px 4px;
  }

  .journey-info-card {
    display: none;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 2.25rem 2.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 24, 42, 0.05), 0 4px 10px -2px rgba(0, 24, 42, 0.02);
    grid-template-columns: 1.15fr 1fr;
    gap: 2.5rem;
    align-items: start;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 250ms ease-out, transform 250ms ease-out;
  }

  .journey-info-card.active {
    display: grid;
    opacity: 1;
    transform: translateY(0);
  }

  .journey-info-card[hidden] {
    display: none !important;
  }

  /* Left Column of Panel */
  .card-left-col {
    display: flex;
    flex-direction: column;
  }

  .panel-stage-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-growth-teal, #00AB96);
    background: rgba(0, 171, 150, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    align-self: flex-start;
    margin-bottom: 0.65rem;
  }

  .panel-stage-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .panel-stage-sub {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-slate-muted, #64748B);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #F1F5F9;
  }

  .panel-intro-text {
    font-size: 0.975rem;
    color: var(--color-slate-text, #334155);
    line-height: 1.65;
    margin: 0;
  }

  /* Right Column of Panel */
  .card-right-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 1.35rem 1.5rem;
  }

  .panel-focus-box {
    display: flex;
    flex-direction: column;
  }

  .focus-heading {
    font-size: 0.825rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .focus-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .focus-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .check-icon {
    color: var(--color-growth-teal, #00AB96);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .focus-text {
    font-size: 0.875rem;
    color: var(--color-primary-navy, #00182A);
    font-weight: 600;
    line-height: 1.4;
  }

  /* Simple Takeaway Box */
  .panel-takeaway-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-left: 3px solid var(--color-growth-teal, #00AB96);
    border-radius: 0 8px 8px 0;
    padding: 0.75rem 1rem;
  }

  .takeaway-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-navy, #00182A);
  }

  .takeaway-text {
    font-size: 0.85rem;
    color: var(--color-slate-text, #334155);
    line-height: 1.5;
    margin: 0;
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .journey-step-btn,
    .step-circle,
    .journey-disclosure-wrapper,
    .journey-info-card {
      transition: none !important;
      transform: none !important;
    }
  }

  /* Responsive Adjustments */
  @media (max-width: 1023px) {
    .journey-stepper-track {
      gap: 0.5rem;
    }

    .step-circle {
      width: 42px;
      height: 42px;
      margin-bottom: 0.65rem;
    }

    .step-number {
      font-size: 1rem;
    }

    .step-title {
      font-size: 0.875rem;
    }

    .step-subtitle {
      font-size: 0.725rem;
    }

    .journey-info-card {
      padding: 1.75rem 2rem;
      gap: 1.75rem;
    }

    .panel-stage-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 767px) {
    .journey-section {
      padding: 3.5rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-title {
      font-size: 1.85rem;
    }

    .journey-track-wrapper {
      margin-left: -1rem;
      margin-right: -1rem;
      padding: 0 1rem 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .journey-track-wrapper::-webkit-scrollbar {
      display: none;
    }

    .journey-stepper-track {
      display: flex;
      width: max-content;
      gap: 1rem;
      padding-bottom: 0.5rem;
    }

    .journey-connecting-line {
      display: none;
    }

    .journey-step-btn {
      flex: 0 0 140px;
      max-width: 140px;
      scroll-snap-align: start;
      padding: 0.5rem 0.25rem;
      border-radius: 8px;
    }

    .journey-info-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem 1.25rem;
      border-radius: 14px;
    }

    .panel-stage-title {
      font-size: 1.35rem;
    }

    .card-right-col {
      padding: 1.15rem 1.25rem;
    }
  }
</style>
