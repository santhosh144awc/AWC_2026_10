---
import { siteConfig } from '../data/siteConfig';
---

<section class="journey-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">Your Financial Wellbeing Journey</h2>
      <p class="section-subtitle">
        Every family moves through different financial stages. Knowing what to focus on today can help you prepare for what comes next.
      </p>
    </div>

    <!-- Connected Stage Flow -->
    <div class="journey-timeline-wrapper">
      <div class="timeline-connecting-line"></div>

      <div class="journey-stages-grid">
        {siteConfig.journeyStages.map((stage) => (
          <div class="stage-item">
            <div class="stage-badge-container">
              <div class="stage-number-badge">
                <span>{stage.step}</span>
              </div>
            </div>
            <div class="stage-content-wrap">
              <h3 class="stage-title">{stage.title}</h3>
              <p class="stage-focus">{stage.focus}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .journey-section {
    background-color: var(--color-white);
  }

  .journey-timeline-wrapper {
    position: relative;
    margin-top: 3rem;
  }

  .timeline-connecting-line {
    position: absolute;
    top: 28px;
    left: 8%;
    right: 8%;
    height: 3px;
    background: linear-gradient(90deg, #00182A 0%, #00AB96 50%, #FFC107 100%);
    z-index: 1;
    opacity: 0.8;
  }

  .journey-stages-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
    position: relative;
    z-index: 2;
  }

  .stage-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stage-badge-container {
    position: relative;
    margin-bottom: 1.25rem;
  }

  .stage-number-badge {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--color-primary-navy);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 800;
    font-family: var(--font-heading);
    box-shadow: 0 4px 12px rgba(0, 24, 42, 0.2);
    border: 4px solid var(--color-white);
    transition: transform var(--transition-normal), background-color var(--transition-normal);
  }

  .stage-item:hover .stage-number-badge {
    background-color: var(--color-growth-teal);
    transform: scale(1.15);
  }

  .stage-content-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stage-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }

  .stage-focus {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-slate-muted);
    line-height: 1.35;
    max-width: 160px;
  }

  /* Responsive Timeline: Vertical flow on Mobile & Tablet */
  @media (max-width: 992px) {
    .timeline-connecting-line {
      display: none;
    }

    .journey-timeline-wrapper {
      position: relative;
      padding-left: 2rem;
      margin-top: 2rem;
    }

    .journey-timeline-wrapper::before {
      content: '';
      position: absolute;
      top: 15px;
      bottom: 15px;
      left: 48px;
      width: 3px;
      background: linear-gradient(180deg, #00182A 0%, #00AB96 50%, #FFC107 100%);
      z-index: 1;
    }

    .journey-stages-grid {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    .stage-item {
      flex-direction: row;
      text-align: left;
      align-items: center;
      gap: 1.5rem;
    }

    .stage-badge-container {
      margin-bottom: 0;
      flex-shrink: 0;
      z-index: 2;
    }

    .stage-content-wrap {
      align-items: flex-start;
    }

    .stage-focus {
      max-width: 100%;
    }
  }
</style>
