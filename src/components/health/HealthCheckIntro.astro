---
---

<div class="health-intro-wrapper">
  <div class="health-badge">
    <span class="badge-dot"></span>
    <span>Free 2-Minute Diagnostic</span>
  </div>

  <h1 class="health-title">
    How Financially Healthy Are You?
  </h1>

  <p class="health-subtitle">
    Evaluate your emergency preparedness, insurance coverage, saving habits, and retirement readiness through 7 simple, multiple-choice questions.
  </p>

  <div class="health-perks-row">
    <div class="perk-item">
      <span class="perk-icon">⏱</span>
      <span>Takes ~2 minutes</span>
    </div>
    <div class="perk-item">
      <span class="perk-icon">🔒</span>
      <span>100% Free & Confidential</span>
    </div>
    <div class="perk-item">
      <span class="perk-icon">🚫</span>
      <span>No Phone Number or Login Needed</span>
    </div>
    <div class="perk-item">
      <span class="perk-icon">📊</span>
      <span>Instant Personalized Diagnostic</span>
    </div>
  </div>
</div>

<style>
  .health-intro-wrapper {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem auto;
  }

  .health-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background-color: rgba(0, 171, 150, 0.1);
    color: #00AB96;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: #00AB96;
    border-radius: 50%;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .health-title {
    font-family: 'Outfit', sans-serif;
    font-size: 2.75rem;
    font-weight: 800;
    color: #00182A;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .health-subtitle {
    font-size: 1.15rem;
    color: #64748B;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .health-perks-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: #334155;
    font-weight: 600;
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
  }

  .perk-icon {
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .health-title {
      font-size: 2.1rem;
    }

    .health-subtitle {
      font-size: 1rem;
    }

    .health-perks-row {
      gap: 0.75rem;
    }
  }
</style>
