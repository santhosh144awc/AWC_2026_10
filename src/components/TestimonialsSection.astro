---
import { testimonials } from '../data/testimonials';

// TODO: Replace placeholder testimonials with verified client testimonials after approval.
---

<section class="testimonials-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">What Our Clients Say</h2>
      <p class="section-subtitle">
        Real experiences from families we have helped.
      </p>
    </div>

    <!-- 3-Column Testimonials Placeholder Grid -->
    <div class="testimonials-grid">
      {testimonials.map((item) => (
        <div class="testimonial-card card-base">
          <!-- Quote Icon -->
          <div class="quote-mark" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
          </div>

          <p class="testimonial-quote">
            "{item.quote}"
          </p>

          <div class="testimonial-footer">
            <div class="client-avatar-placeholder" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <div class="client-meta">
              <h3 class="client-name">{item.name}</h3>
              <p class="client-role">{item.role} • {item.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    padding: 5rem 1.5rem;
  }

  .section-header {
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary-navy);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--color-slate-text);
    line-height: 1.5;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonial-card {
    background-color: var(--color-white);
    border: 1px solid #E2E8F0;
    border-radius: var(--radius-xl);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 2px 8px rgba(0, 24, 42, 0.04);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 24, 42, 0.08);
  }

  .quote-mark {
    color: rgba(0, 171, 150, 0.25);
    margin-bottom: 1.25rem;
  }

  .testimonial-quote {
    font-size: 1.025rem;
    line-height: 1.65;
    color: var(--color-navy-dark);
    font-style: italic;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .testimonial-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid #F1F5F9;
  }

  .client-avatar-placeholder {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #EEF2F6;
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .client-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .client-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    margin: 0;
  }

  .client-role {
    font-size: 0.825rem;
    color: var(--color-slate-text);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .testimonials-section {
      padding: 3.5rem 1rem;
    }

    .section-title {
      font-size: 1.85rem;
    }
  }
</style>
