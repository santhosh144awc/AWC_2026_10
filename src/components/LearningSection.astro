---
import { getCollection } from 'astro:content';

let articles: any[] = [];
try {
  articles = await getCollection('articles', ({ data }) => !data.draft);
} catch (e) {
  articles = [];
}

const hasArticles = articles && articles.length > 0;

// Sort by: 1. Featured articles first, 2. Most recent publishDate descending (top 4 curated articles)
const displayArticles = hasArticles 
  ? [...articles]
      .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
      })
      .slice(0, 4)
  : [];
---

<section class="learning-section section-padding">
  <div class="learning-container">
    <div class="section-header text-center">
      <h2 class="section-title">Learn About Money</h2>
      <p class="section-subtitle">
        Simple explanations to help you make better financial decisions.
      </p>
    </div>

    {hasArticles ? (
      <div class="learning-shelf-wrapper">
        <div class="articles-shelf">
          {displayArticles.map((article) => {
            const formattedDate = article.data.publishDate 
              ? new Date(article.data.publishDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })
              : 'Aug 2026';
            const readingTime = article.data.readingTime || '5 min read';

            return (
              <article class={`article-shelf-card ${article.data.featured ? 'article-featured' : ''}`}>
                <div class="card-content-top">
                  <div class="badge-row">
                    <span class="category-pill" title={article.data.category}>{article.data.category}</span>
                    <span class="reading-time">{readingTime}</span>
                  </div>
                  <h3 class="article-title">
                    <a href={`/learn/${article.slug}`} class="article-link">
                      {article.data.title}
                    </a>
                  </h3>
                  <p class="article-desc">
                    {article.data.description}
                  </p>
                </div>
                
                <div class="card-footer">
                  <span class="publish-date">{formattedDate}</span>
                  <a 
                    href={`/learn/${article.slug}`} 
                    class="read-more-link"
                    aria-label={`Read article: ${article.data.title}`}
                  >
                    <span>Read Article</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    ) : (
      <div class="empty-state text-center">
        <p>New financial guides are published weekly. Check back soon!</p>
      </div>
    )}

    <!-- Explore All Guides Link -->
    <div class="explore-all-wrap text-center">
      <a href="/learn" class="btn btn-outline btn-lg explore-all-btn">
        Explore All Guides →
      </a>
    </div>
  </div>
</section>

<style>
  .learning-section {
    background-color: var(--color-white, #FFFFFF);
    padding: 5rem 0;
    overflow: hidden;
  }

  .learning-container {
    width: 100%;
    max-width: 1240px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .section-header {
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary-navy, #00182A);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--color-slate-text, #64748B);
    line-height: 1.5;
  }

  .learning-shelf-wrapper {
    width: 100%;
    margin-bottom: 2.5rem;
  }

  /* Desktop: 4 cards with comfortable reading width and generous padding */
  .articles-shelf {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .article-shelf-card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 1.5rem 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    height: 100%;
    min-height: 330px;
    box-shadow: 0 4px 12px rgba(0, 24, 42, 0.03);
  }

  .article-shelf-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-growth-teal, #00AB96);
    box-shadow: 0 12px 28px rgba(0, 24, 42, 0.08);
  }

  .article-featured {
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    border-color: #CBD5E1;
  }

  .card-content-top {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    min-height: 24px;
  }

  .category-pill {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-growth-teal, #00AB96);
    background-color: rgba(0, 171, 150, 0.08);
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .reading-time {
    font-size: 0.75rem;
    color: #64748B;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .article-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.075rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.65rem;
    color: var(--color-primary-navy, #00182A);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-link {
    color: var(--color-primary-navy, #00182A);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-link:hover,
  .article-shelf-card:hover .article-link {
    color: var(--color-growth-teal, #00AB96);
  }

  .article-desc {
    font-size: 0.875rem;
    color: var(--color-slate-text, #64748B);
    line-height: 1.5;
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid #F1F5F9;
    margin-top: auto;
    gap: 0.5rem;
  }

  .publish-date {
    font-size: 0.775rem;
    color: #94A3B8;
    white-space: nowrap;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--color-primary-navy, #00182A);
    text-decoration: none;
    min-height: 44px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .read-more-link:hover,
  .article-shelf-card:hover .read-more-link {
    color: var(--color-growth-teal, #00AB96);
  }

  .read-more-link svg {
    transition: transform 0.2s ease;
  }

  .read-more-link:hover svg,
  .article-shelf-card:hover .read-more-link svg {
    transform: translateX(2px);
  }

  .explore-all-wrap {
    margin-top: 0.5rem;
  }

  .explore-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-lg, 20px);
    border: 2px solid var(--color-primary-navy, #00182A);
    color: var(--color-primary-navy, #00182A);
    background-color: transparent;
    transition: all var(--transition-normal, 250ms ease);
    min-height: 48px;
  }

  .explore-all-btn:hover {
    background-color: var(--color-primary-navy, #00182A);
    color: var(--color-white, #FFFFFF);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 24, 42, 0.12);
  }

  /* Tablet (641px to 1099px): 2x2 Grid for generous reading comfort */
  @media (max-width: 1099px) and (min-width: 641px) {
    .articles-shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  /* Mobile: Contained Horizontal Swipeable Shelf (< 640px) */
  @media (max-width: 640px) {
    .learning-section {
      padding: 3.5rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-title {
      font-size: 1.85rem;
    }

    .learning-container {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .learning-shelf-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-left: -1rem;
      margin-right: -1rem;
      padding: 0.5rem 1rem 1rem;
    }

    .learning-shelf-wrapper::-webkit-scrollbar {
      display: none;
    }

    .articles-shelf {
      display: flex;
      gap: 1rem;
      width: max-content;
      margin-bottom: 0;
    }

    .article-shelf-card {
      flex: 0 0 82vw;
      max-width: 320px;
      min-width: 260px;
      scroll-snap-align: start;
      padding: 1.35rem 1.2rem;
    }
  }
</style>
