---
import { getCollection } from 'astro:content';
import ArticleCard from './learning/ArticleCard.astro';

let articles: any[] = [];
try {
  articles = await getCollection('articles', ({ data }) => !data.draft);
} catch (e) {
  articles = [];
}

const hasArticles = articles && articles.length > 0;

// Sort by: 1. Featured articles first, 2. Most recent publishDate descending
const displayArticles = hasArticles 
  ? [...articles]
      .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
      })
      .slice(0, 6)
  : [];
---

<section class="learning-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">Learn About Money</h2>
      <p class="section-subtitle">
        Simple explanations to help you make better financial decisions.
      </p>
    </div>

    {hasArticles ? (
      <div class="articles-grid">
        {displayArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.slug}
            category={article.data.category}
            readingTime={article.data.readingTime}
            publishDate={article.data.publishDate}
            featured={article.data.featured}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state text-center">
        <p>New financial guides are published weekly. Check back soon!</p>
      </div>
    )}

    <!-- Explore All Guides Link -->
    <div class="explore-all-wrap text-center">
      <a href="/learn" class="btn btn-outline btn-lg explore-all-btn">
        Explore All Guides →
      </a>
    </div>
  </div>
</section>

<style>
  .learning-section {
    background-color: var(--color-white);
    padding: 5rem 1.5rem;
  }

  .section-header {
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary-navy);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--color-slate-text);
    line-height: 1.5;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .explore-all-wrap {
    margin-top: 1rem;
  }

  .explore-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-primary-navy);
    color: var(--color-primary-navy);
    background-color: transparent;
    transition: all var(--transition-normal);
  }

  .explore-all-btn:hover {
    background-color: var(--color-primary-navy);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 24, 42, 0.12);
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .learning-section {
      padding: 3.5rem 1rem;
    }

    .section-title {
      font-size: 1.85rem;
    }
  }
</style>
