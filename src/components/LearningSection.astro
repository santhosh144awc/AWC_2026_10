---
import { getCollection } from 'astro:content';
import ArticleCard from './learning/ArticleCard.astro';

let articles: any[] = [];
try {
  articles = await getCollection('articles', ({ data }) => !data.draft);
} catch (e) {
  articles = [];
}

const hasArticles = articles && articles.length > 0;
const displayArticles = hasArticles 
  ? articles.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()).slice(0, 3)
  : [];
---

<section class="learning-section section-padding">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-teal mb-2">Knowledge & Insights</div>
      <h2 class="section-title">Money Made Simple</h2>
      <p class="section-subtitle">
        Learn personal finance, mutual fund principles, and risk management in plain, jargon-free language.
      </p>
    </div>

    {hasArticles ? (
      <div class="articles-grid">
        {displayArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.slug}
            category={article.data.category}
            readingTime={article.data.readingTime}
            publishDate={article.data.publishDate}
          />
        ))}
      </div>
    ) : (
      <!-- Clean Topic Previews Architecture (Zero Fake Articles) -->
      <div class="learning-hub-wrapper">
        <div class="topics-grid">
          <a href="/learn#mutual-funds" class="topic-card card-base">
            <div class="topic-icon-circle bg-teal-soft">📈</div>
            <div class="topic-info">
              <span class="topic-tag-pill">Investing</span>
              <h3 class="topic-title">Mutual Fund Basics</h3>
              <p class="topic-desc">Understand equity, debt, index funds, and active vs passive strategies.</p>
            </div>
          </a>

          <a href="/learn#sip" class="topic-card card-base">
            <div class="topic-icon-circle bg-green-soft">🌱</div>
            <div class="topic-info">
              <span class="topic-tag-pill">Strategy</span>
              <h3 class="topic-title">SIP & Lumpsum</h3>
              <p class="topic-desc">The mathematics of compounding, rupee-cost averaging, and step-up SIPs.</p>
            </div>
          </a>

          <a href="/learn#allocation" class="topic-card card-base">
            <div class="topic-icon-circle bg-navy-soft">⚖️</div>
            <div class="topic-info">
              <span class="topic-tag-pill">Portfolio</span>
              <h3 class="topic-title">Asset Allocation</h3>
              <p class="topic-desc">Balancing equity, debt, gold, and liquid assets for optimal risk-adjusted returns.</p>
            </div>
          </a>

          <a href="/learn#retirement" class="topic-card card-base">
            <div class="topic-info">
              <div class="topic-icon-circle bg-gold-soft">🌅</div>
              <span class="topic-tag-pill">Retirement</span>
              <h3 class="topic-title">Retirement Planning</h3>
              <p class="topic-desc">Calculating inflation-adjusted corpus, withdrawal rates, and pension alternatives.</p>
            </div>
          </a>

          <a href="/learn#protection" class="topic-card card-base">
            <div class="topic-info">
              <div class="topic-icon-circle bg-blue-soft">🛡️</div>
              <span class="topic-tag-pill">Protection</span>
              <h3 class="topic-title">Insurance & Risk</h3>
              <p class="topic-desc">Separating investment from insurance with pure term cover and family health plans.</p>
            </div>
          </a>

          <a href="/learn#bonds-gold" class="topic-card card-base">
            <div class="topic-info">
              <div class="topic-icon-circle bg-teal-soft">🪙</div>
              <span class="topic-tag-pill">Assets</span>
              <h3 class="topic-title">Bonds, Gold & Taxes</h3>
              <p class="topic-desc">Sovereign gold bonds, fixed income security, and capital gains tax planning.</p>
            </div>
          </a>
        </div>
      </div>
    )}

    <div class="section-footer-link mt-4">
      <a href="/learn" class="link-with-arrow">
        View All Articles & Guides
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .learning-section {
    background-color: var(--color-bg-light);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .mb-2 {
    margin-bottom: 0.5rem;
  }

  .mt-4 {
    margin-top: 2.5rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  @media (max-width: 992px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  .article-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .article-img-wrap {
    height: 180px;
    overflow: hidden;
  }

  .article-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .article-card:hover .article-img-wrap img {
    transform: scale(1.05);
  }

  .article-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .article-category {
    align-self: flex-start;
    margin-bottom: 0.75rem;
  }

  .article-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .article-title a:hover {
    color: var(--color-growth-teal);
  }

  .article-desc {
    font-size: 0.9rem;
    color: var(--color-slate-muted);
    line-height: 1.5;
  }

  /* Topic Previews Grid */
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 992px) {
    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .topics-grid {
      grid-template-columns: 1fr;
    }
  }

  .topic-card {
    padding: 1.75rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    text-decoration: none;
    border-radius: var(--radius-xl);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-normal);
  }

  .topic-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-growth-teal);
    box-shadow: var(--shadow-card-hover);
  }

  .topic-icon-circle {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .bg-teal-soft {
    background-color: var(--color-growth-teal-light);
  }

  .bg-green-soft {
    background-color: #ECFDF5;
  }

  .bg-blue-soft {
    background-color: #EFF6FF;
  }

  .bg-navy-soft {
    background-color: #F1F5F9;
  }

  .bg-gold-soft {
    background-color: #FFFBEB;
  }

  .topic-info {
    display: flex;
    flex-direction: column;
  }

  .topic-tag-pill {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-growth-teal);
    margin-bottom: 0.35rem;
  }

  .topic-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-navy);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .topic-desc {
    font-size: 0.85rem;
    color: var(--color-slate-muted);
    line-height: 1.45;
  }

  .section-footer-link {
    text-align: center;
  }

  .link-with-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary-navy);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .link-with-arrow:hover {
    color: var(--color-growth-teal);
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .hub-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .learning-hub-card {
      padding: 1.75rem;
    }
  }
</style>
