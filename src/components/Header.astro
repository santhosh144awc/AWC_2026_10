---
import { siteConfig } from '../data/siteConfig';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="header-container">
    <!-- Brand Logo (More Prominent & Visually Aligned) -->
    <a href="/" class="brand-logo" aria-label="Ant Wealth Creation Home">
      <img 
        src="/assets/logo_with_tagline.webp" 
        alt="Ant Wealth Creation — Make Better Money Decisions. Build a Better Future." 
        class="logo-img"
        width="300"
        height="64"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation (Simplified Navigation Retained) -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {siteConfig.nav.map((item) => (
          <li class="nav-item">
            <a 
              href={item.href} 
              class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Portfolio Login) -->
    <div class="header-actions">
      <a 
        href={siteConfig.portfolioLogin.href} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-portfolio-login"
      >
        {siteConfig.portfolioLogin.label}
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button 
        id="mobile-menu-toggle" 
        class="mobile-toggle-btn" 
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div id="mobile-nav" class="mobile-nav-drawer" aria-hidden="true">
    <ul class="mobile-nav-list">
      {siteConfig.nav.map((item) => (
        <li class="mobile-nav-item">
          <a 
            href={item.href} 
            class={`mobile-nav-link ${currentPath === item.href ? 'active' : ''}`}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mobile-nav-cta-item">
        <a 
          href={siteConfig.portfolioLogin.href} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-portfolio-login mobile-portfolio-btn"
        >
          {siteConfig.portfolioLogin.label}
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height, 90px);
    min-height: 85px;
    display: flex;
    align-items: center;
    width: 100%;
    box-shadow: 0 1px 3px rgba(0, 24, 42, 0.03);
  }

  .header-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Left Column: Brand Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-img {
    height: 62px;
    width: auto;
    max-width: 320px;
    object-fit: contain;
    display: block;
    transition: transform var(--transition-fast);
  }

  .brand-logo:hover .logo-img {
    transform: scale(1.015);
  }

  /* Center/Right: Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    margin-left: auto;
    margin-right: 1.5rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-slate-text);
    padding: 0.5rem 0.25rem;
    position: relative;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary-navy);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--color-growth-teal);
    border-radius: var(--radius-full);
  }

  /* Right Column: Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .btn-portfolio-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-navy);
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    border: 1px solid var(--color-primary-navy);
    transition: all var(--transition-normal);
    box-shadow: 0 2px 6px rgba(0, 24, 42, 0.08);
    white-space: nowrap;
  }

  .btn-portfolio-login:hover {
    background-color: var(--color-growth-teal);
    border-color: var(--color-growth-teal);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 171, 150, 0.25);
  }

  .mobile-toggle-btn {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 101;
  }

  .hamburger-line {
    width: 100%;
    height: 2.5px;
    background-color: var(--color-primary-navy);
    border-radius: 2px;
    transition: all var(--transition-normal);
  }

  .mobile-toggle-btn.open .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-toggle-btn.open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle-btn.open .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  .mobile-nav-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-nav-drawer.open {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-slate-text);
    padding: 0.5rem 0;
    display: block;
    text-decoration: none;
  }

  .mobile-nav-link.active,
  .mobile-nav-link:hover {
    color: var(--color-growth-teal);
    font-weight: 600;
  }

  .mobile-nav-cta-item {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .mobile-portfolio-btn {
    width: 100%;
    padding: 0.85rem 1.5rem;
    font-size: 1rem;
  }

  @media (max-width: 1200px) {
    .header-container {
      padding: 0 2rem;
      gap: 1.25rem;
    }

    .nav-list {
      gap: 1.5rem;
    }

    .logo-img {
      height: 56px;
    }
  }

  @media (max-width: 992px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle-btn {
      display: flex;
    }

    .btn-portfolio-login:not(.mobile-portfolio-btn) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      height: 74px;
      min-height: 74px;
    }

    .header-container {
      padding: 0 1.25rem;
      gap: 0.75rem;
    }

    .logo-img {
      height: 48px;
      max-width: 230px;
    }

    .mobile-toggle-btn {
      min-width: 44px;
      min-height: 44px;
      padding: 8px;
    }

    .mobile-nav-link {
      padding: 0.75rem 0;
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = toggleBtn.classList.toggle('open');
      mobileNav.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      mobileNav.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!toggleBtn.contains(target) && !mobileNav.contains(target) && mobileNav.classList.contains('open')) {
        toggleBtn.classList.remove('open');
        mobileNav.classList.remove('open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
      }
    });
  }
</script>
