---
import BaseLayout from '../layouts/BaseLayout.astro';
import HealthCheckIntro from '../components/health/HealthCheckIntro.astro';
import HealthQuestionnaire from '../components/health/HealthQuestionnaire';
---

<BaseLayout 
  title="Financial Health Check — Ant Wealth Creation" 
  description="Evaluate your emergency preparedness, insurance coverage, saving habits, and retirement readiness through a free 2-minute diagnostic."
  currentPath="/health-check"
>
  <main class="health-check-page">
    <div class="container page-container">
      <HealthCheckIntro />
      <HealthQuestionnaire client:load />

      <div class="real-statement-discovery-card">
        <div class="disc-text">
          <span class="disc-tag">Comprehensive Diagnostic</span>
          <h3 class="disc-title">Want a deeper look at your finances?</h3>
          <p class="disc-desc">
            Create your <strong>Complete Financial Statement (REAL Statement)</strong> — map your income, expenses, monthly savings, assets, liabilities, and calculate your <strong>Actual Net Worth</strong>.
          </p>
        </div>
        <a href="/health-check/real-statement" class="btn-disc">
          Create Financial Statement →
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .health-check-page {
    background-color: #F8FAFC;
    padding: 3.5rem 0 5rem 0;
    min-height: calc(100vh - 80px - 300px);
  }

  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .real-statement-discovery-card {
    margin-top: 3.5rem;
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    padding: 2rem 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    transition: all 0.2s ease;
  }

  .real-statement-discovery-card:hover {
    border-color: #00AB96;
    box-shadow: 0 8px 25px rgba(0, 171, 150, 0.08);
  }

  .disc-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #00AB96;
    background-color: rgba(0, 171, 150, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.4rem;
  }

  .disc-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #00182A;
    margin: 0 0 0.35rem 0;
  }

  .disc-desc {
    font-size: 0.925rem;
    color: #64748B;
    margin: 0;
    line-height: 1.5;
    max-width: 600px;
  }

  .btn-disc {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    background-color: #00182A;
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .btn-disc:hover {
    background-color: #00AB96;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 171, 150, 0.25);
  }

  @media (max-width: 768px) {
    .health-check-page {
      padding: 2.5rem 0 4rem 0;
    }

    .real-statement-discovery-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem 1.25rem;
    }

    .btn-disc {
      width: 100%;
      justify-content: center;
    }
  }
</style>

