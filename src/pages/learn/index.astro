---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/learning/ArticleCard.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

// Sort by publishDate descending
const sortedArticles = [...allArticles].sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredArticles = sortedArticles.filter(a => a.data.featured);

const TOPICS = [
  { id: 'all', name: 'All Topics', icon: '📚' },
  { id: 'money-basics', name: 'Money Basics', icon: '🧭', matchKeywords: ['basics', 'personal finance', 'financial planning', 'freedom'] },
  { id: 'saving', name: 'Saving', icon: '💰', matchKeywords: ['saving', 'emergency', 'cash flow'] },
  { id: 'investing', name: 'Investing', icon: '📈', matchKeywords: ['investing', 'mutual fund', 'sip', 'compounding', 'wealth'] },
  { id: 'protection', name: 'Protection', icon: '🛡️', matchKeywords: ['protection', 'insurance', 'life insurance'] },
  { id: 'goals', name: 'Goals', icon: '🎯', matchKeywords: ['goals', 'goal', 'education', 'child'] },
  { id: 'loans', name: 'Loans', icon: '⚖️', matchKeywords: ['loans', 'loan', 'debt', 'repay'] },
  { id: 'retirement', name: 'Retirement', icon: '🌅', matchKeywords: ['retirement', 'pension'] }
];
---

<BaseLayout 
  title="Learn About Money — Ant Wealth Creation" 
  description="Simple explanations to help you make better financial decisions. Explore jargon-free guides on savings, investing, SIPs, protection, loans, and retirement."
  currentPath="/learn"
>
  <!-- Hero Section -->
  <section class="learn-hero-section">
    <div class="container text-center">
      <div class="badge-tag">
        <span class="badge-dot"></span>
        Financial Education
      </div>
      <h1 class="page-title">Learn About Money</h1>
      <p class="page-subtitle">
        Simple explanations to help you make better financial decisions.
      </p>
    </div>
  </section>

  <!-- Browse by Topic Section -->
  <section class="topics-section">
    <div class="container">
      <div class="section-label-wrap text-center">
        <span class="section-subheading-tag">BROWSE BY TOPIC</span>
      </div>

      <div class="topic-chips-wrapper" id="topicFilter">
        {TOPICS.map(topic => (
          <button 
            type="button"
            class={`topic-chip ${topic.id === 'all' ? 'active' : ''}`}
            data-topic={topic.id}
          >
            <span class="topic-icon">{topic.icon}</span>
            <span class="topic-label">{topic.name}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Guides Section (If Any) -->
  {featuredArticles.length > 0 && (
    <section class="featured-section" id="featuredSection">
      <div class="container">
        <div class="section-header-row">
          <div>
            <span class="section-subheading-tag">ESSENTIAL READING</span>
            <h2 class="section-heading">Featured Guides</h2>
          </div>
        </div>

        <div class="articles-grid featured-grid">
          {featuredArticles.slice(0, 3).map(article => (
            <div class="article-item" data-category={article.data.category.toLowerCase()} data-tags={(article.data.tags || []).join(',').toLowerCase()} data-title={article.data.title.toLowerCase()}>
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                slug={article.slug}
                category={article.data.category}
                readingTime={article.data.readingTime}
                publishDate={article.data.publishDate}
                featured={true}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest / All Articles Section -->
  <section class="library-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-subheading-tag">ARTICLE DIRECTORY</span>
          <h2 class="section-heading" id="libraryTitle">Latest Articles ({sortedArticles.length})</h2>
        </div>
      </div>

      <div class="articles-grid" id="articlesGrid">
        {sortedArticles.map(article => (
          <div class="article-item" data-category={article.data.category.toLowerCase()} data-tags={(article.data.tags || []).join(',').toLowerCase()} data-title={article.data.title.toLowerCase()}>
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              slug={article.slug}
              category={article.data.category}
              readingTime={article.data.readingTime}
              publishDate={article.data.publishDate}
            />
          </div>
        ))}
      </div>

      <div class="no-articles-found text-center" id="noArticlesMsg" style="display: none;">
        <p>No guides found in this topic yet. Check back soon for weekly additions!</p>
      </div>
    </div>
  </section>

  <!-- Interactive Planning CTA -->
  <section class="learning-action-cta">
    <div class="container">
      <div class="cta-inner-box text-center">
        <h3 class="cta-heading">Ready to put your learning into practice?</h3>
        <p class="cta-desc">
          Understand where you stand today with the Financial Health Check or explore our simple tools.
        </p>
        <div class="cta-buttons-row">
          <a href="/health-check" class="btn-primary-cta">
            Check My Financial Health →
          </a>
          <a href="/tools" class="btn-secondary-cta">
            Explore Tools →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Simple, robust client-side topic filtering
  const topicButtons = document.querySelectorAll('.topic-chip');
  const articleItems = document.querySelectorAll('#articlesGrid .article-item');
  const featuredSection = document.getElementById('featuredSection');
  const libraryTitle = document.getElementById('libraryTitle');
  const noArticlesMsg = document.getElementById('noArticlesMsg');

  const topicKeywords: Record<string, string[]> = {
    'money-basics': ['basics', 'personal finance', 'financial planning', 'freedom', 'allocation', 'money basics'],
    'saving': ['saving', 'emergency', 'cash flow', 'savings'],
    'investing': ['investing', 'mutual fund', 'sip', 'compounding', 'wealth', 'lumpsum'],
    'protection': ['protection', 'insurance', 'life insurance', 'term insurance'],
    'goals': ['goals', 'goal', 'education', 'child', 'children'],
    'loans': ['loans', 'loan', 'debt', 'repay', 'prepayment'],
    'retirement': ['retirement', 'pension', 'freedom']
  };

  topicButtons.forEach(button => {
    button.addEventListener('click', () => {
      topicButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      const topicId = button.getAttribute('data-topic') || 'all';
      let visibleCount = 0;

      if (topicId === 'all') {
        if (featuredSection) featuredSection.style.display = 'block';
        if (libraryTitle) libraryTitle.textContent = `Latest Articles (${articleItems.length})`;
        articleItems.forEach(item => {
          (item as HTMLElement).style.display = 'block';
          visibleCount++;
        });
      } else {
        if (featuredSection) featuredSection.style.display = 'none';
        const keywords = topicKeywords[topicId] || [topicId];
        const topicName = button.querySelector('.topic-label')?.textContent || 'Selected Topic';
        
        articleItems.forEach(item => {
          const category = item.getAttribute('data-category') || '';
          const tags = item.getAttribute('data-tags') || '';
          const title = item.getAttribute('data-title') || '';
          const combined = `${category} ${tags} ${title}`.toLowerCase();

          const matches = keywords.some(kw => combined.includes(kw));
          if (matches) {
            (item as HTMLElement).style.display = 'block';
            visibleCount++;
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });

        if (libraryTitle) libraryTitle.textContent = `${topicName} Guides (${visibleCount})`;
      }

      if (noArticlesMsg) {
        noArticlesMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });
</script>

<style>
  .learn-hero-section {
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    padding: 4.5rem 1.5rem 2.5rem;
  }

  .badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background-color: rgba(0, 171, 150, 0.1);
    color: var(--color-growth-teal);
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-growth-teal);
    border-radius: 50%;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-primary-navy);
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--color-slate-text);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Topics Section */
  .topics-section {
    padding: 1.5rem 1.5rem 3rem;
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
  }

  .section-label-wrap {
    margin-bottom: 1.25rem;
  }

  .section-subheading-tag {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-growth-teal);
    text-transform: uppercase;
  }

  .topic-chips-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    background-color: var(--color-white);
    border: 1px solid #CBD5E1;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-primary-navy);
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .topic-chip:hover {
    border-color: var(--color-growth-teal);
    background-color: #F0FDF4;
    transform: translateY(-1px);
  }

  .topic-chip.active {
    background-color: var(--color-primary-navy);
    border-color: var(--color-primary-navy);
    color: var(--color-white);
    box-shadow: 0 4px 12px rgba(0, 24, 42, 0.15);
  }

  /* Featured & Library Sections */
  .featured-section {
    padding: 4rem 1.5rem 2rem;
    background-color: #FFFFFF;
  }

  .library-section {
    padding: 3rem 1.5rem 5rem;
    background-color: #FFFFFF;
  }

  .section-header-row {
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-top: 0.25rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .featured-grid {
    margin-bottom: 1.5rem;
  }

  .no-articles-found {
    padding: 3rem 1rem;
    color: var(--color-slate-text);
    font-size: 1.05rem;
  }

  /* CTA Box */
  .learning-action-cta {
    background-color: #F8FAFC;
    padding: 4rem 1.5rem;
    border-top: 1px solid #E2E8F0;
  }

  .cta-inner-box {
    max-width: 680px;
    margin: 0 auto;
    background-color: var(--color-white);
    border: 1px solid #E2E8F0;
    border-radius: var(--radius-xl);
    padding: 3rem 2rem;
    box-shadow: 0 4px 16px rgba(0, 24, 42, 0.05);
  }

  .cta-heading {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    font-size: 1.05rem;
    color: var(--color-slate-text);
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .cta-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary-cta {
    background-color: var(--color-growth-teal);
    color: var(--color-white);
    padding: 0.75rem 1.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius-lg);
    transition: all var(--transition-normal);
    text-decoration: none;
  }

  .btn-primary-cta:hover {
    background-color: #009381;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 171, 150, 0.3);
  }

  .btn-secondary-cta {
    background-color: transparent;
    color: var(--color-primary-navy);
    border: 2px solid var(--color-primary-navy);
    padding: 0.75rem 1.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius-lg);
    transition: all var(--transition-normal);
    text-decoration: none;
  }

  .btn-secondary-cta:hover {
    background-color: var(--color-primary-navy);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 2rem;
    }

    .section-heading {
      font-size: 1.5rem;
    }

    .articles-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .learn-hero-section {
      padding: 3rem 1rem 1.5rem;
    }

    .topics-section {
      padding: 1rem 1rem 2rem;
    }

    .topic-chip {
      font-size: 0.85rem;
      padding: 0.5rem 0.9rem;
    }

    .cta-inner-box {
      padding: 2rem 1.25rem;
    }
  }
</style>
